# ---- AI provider -------------------------------------------------------------
# SeniorLink uses Snowflake Cortex AI when the Snowflake values below are filled in.
# Otherwise it uses the Claude API key, and with neither it runs on offline fallbacks.
# AI_PROVIDER=snowflake → Snowflake only, never Claude. AI_PROVIDER=claude → Claude only.

# Snowflake Cortex (https://docs.snowflake.com/en/user-guide/snowflake-cortex/cortex-rest-api)
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_PAT=
SNOWFLAKE_MODEL=claude-sonnet-4-5

# Claude API (optional backup)
ANTHROPIC_API_KEY=sk-ant-...
AI_PROVIDER=snowflake
